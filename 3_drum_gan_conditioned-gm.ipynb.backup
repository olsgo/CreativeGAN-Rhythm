   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Constants"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "os.environ['CUDA_VISIBLE_DEVICES'] = '0' # only relevant to my own environment"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "you can use `0_preprocess_midi-gm.ipynb` to process your own MIDI data.\n",
    "\n",
    "or you can download preprocessed pianoroll data of lots of drum patterns and place them in `./data/`. \n",
    "https://drive.google.com/drive/folders/1IjcSNACkleZKe7AF-FO_RefKvOWwN8NH?usp=sharing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DRUM_CLASSES: ['Kick', 'Snare', 'Hi-hat closed', 'Hi-hat open', 'Low Tom', 'High Tom', 'Cymbal', 'Clap/Cowbell', 'Rim']\n",
      "# of drum instruments: 9\n",
      "dimentionality of random input z: 100\n",
      "resolution of one bar: 16\n",
      "length of rhythm pattern to be generated: 32 beats\n"
     ]
    }
   ],
   "source": [
    "from rhythm_can.constants import *\n",
    "from rhythm_can.utils import *\n",
    "%matplotlib inline\n",
    "\n",
    "print(\"DRUM_CLASSES:\", DRUM_CLASSES)\n",
    "print(\"# of drum instruments:\", nb_notes)\n",
    "\n",
    "print(\"dimentionality of random input z:\", len_input)\n",
    "print(\"resolution of one bar:\", resolution*4) # how many grids in one bar\n",
    "print(\"length of rhythm pattern to be generated:\", len_seq, \"beats\" )\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Genres ['techno' 'house' 'dnb' 'jungle' 'downtempo' 'trance' 'garage' 'old_skool'\n",
      " 'breakbeat']\n",
      "# of Genres 9\n",
      "(1686, 32, 9)\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "matrices_onsets = np.load(\"./data/matrices_drum_gm_clean_no_fill.npz\")['onsets']\n",
    "matrices_velos = np.load(\"./data/matrices_drum_gm_clean_no_fill.npz\")['velocities']\n",
    "matrices_offsets = np.load(\"./data/matrices_drum_gm_clean_no_fill.npz\")['offsets']\n",
    "matrices_genres = np.load(\"./data/matrices_drum_gm_clean_no_fill.npz\")['genre_ids']\n",
    "matrices_drums = matrices_velos\n",
    "\n",
    "GENRES           = np.load(\"./data/matrices_drum_gm_clean_no_fill.npz\")['genres']\n",
    "NB_GENRES = len(GENRES)\n",
    "\n",
    "print(\"Genres\", GENRES)\n",
    "print(\"# of Genres\", NB_GENRES)\n",
    "print(matrices_onsets.shape)"
   ]
  },
