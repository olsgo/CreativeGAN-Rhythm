      "[1.0, 0.3333333333333333]\n"
     ]
    }
   ],
   "source": [
    "# weight for genre classification loss and GAN loss\n",
    "loss_weights = [1., 1/np.sqrt(NB_GENRES)]\n",
    "print(loss_weights)"
   ]
  },
