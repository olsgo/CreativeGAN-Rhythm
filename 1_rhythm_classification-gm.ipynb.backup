   "source": [
    "for i, genre in enumerate(GENRES):\n",
    "    a = matrices_drums[matrices_genres == i]\n",
    "    t = matrices_offsets[matrices_genres == i]\n",
    "    print(genre, int(a.shape[0]))\n",
    "    plot_drum_matrix(a[0])\n",
    "    plot_drum_matrix(t[0])\n",
    "    play_drum_matrix(a[0])\n",
    "    print(\"---------------------------\")"
   ]
  },
